{
  "name": "cold-temp-calc",
  "version": "0.1.0",
  "main": "main.js",
  "type": "module",
  
  "keywords": [
    "cold",
    "temperature",
    "correction",
    "calculator",
    "ctc"
  ],
  
  "scripts": {
    "build": "npx vite build",
	"dist": "npm run build && electron-builder",
	"start-electron": "npm run build && electron ."
  },
  "dependencies": {
    "lucide-react": "^0.308.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vite": "^7.2.4"
  },
  "build": {
    "appId": "org.independent.coldtempcalc",
    "productName": "Cold Temp Correction Calc",
    "files": [
      "dist/**/*",
      "main.js",
      "icon.png"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
}
}